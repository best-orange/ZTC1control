<!--pages/index/index.wxml-->
<navigation-bar title="智能控制" back="{{false}}" color="#000000" background="#FFFFFF">
  <view slot="right" class="nav-btn" hover-class="nav-btn-hover" bindtap="onRefresh">刷新</view>
</navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="statusbar status-{{status}}">
    <view class="dot"></view>
    <view class="status-info">
      <text class="status-text">MQTT：{{statusText}}</text>
      <text class="status-tip" wx:if="{{status!=='connected'}}">（请配置 wss 服务）</text>
    </view>
    <view class="settings-link" hover-class="nav-btn-hover" bindtap="goSettings">设置</view>
  </view>

  <view class="dev-list" wx:if="{{list.length}}">
    <view
      wx:for="{{list}}"
      wx:key="mac"
      class="device-row"
      data-mac="{{item.mac}}"
      bindtap="openDevice"
      bindlongpress="onDeviceLongPress"
    >
      <view class="conn {{item.online?'on':'off'}}"></view>
      <view class="dev-info">
        <!-- 点名字改名：catchtap 阻止冒泡，否则会同时触发整行的 openDevice 跳转 -->
        <view class="dev-name" data-mac="{{item.mac}}" data-name="{{item.name}}" catchtap="onRename">{{item.name}}</view>
        <view class="dev-type">{{item.typeName}} · {{item.mac}}</view>
      </view>
      <view class="dev-arrow">›</view>
    </view>
    <view class="hint">点击名称可改名 · 长按可删除设备</view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-icon">📡</view>
    <view class="empty-title">还没有设备</view>
    <view class="empty-sub">添加你的智能设备后即可远程控制</view>
    <button class="cta" bindtap="goAdd">＋ 添加设备</button>
    <button class="cta plain" bindtap="goSettings">配置 MQTT 服务器</button>
  </view>
</scroll-view>

<!-- 常驻的“添加设备”悬浮按钮（有设备时也能继续添加） -->
<view class="fab" wx:if="{{list.length}}" hover-class="fab-hover" bindtap="goAdd">＋</view>