/* pages/device-add/device-add.wxss */
page {
  height: 100vh;
  background: #f5f6fa;
  display: flex; flex-direction: column;
}
.scrollarea { flex: 1; overflow-y: auto; padding: 24rpx; box-sizing: border-box; }
.nav-btn {
  color: #1989fa; font-size: 28rpx;
  padding: 0 28rpx;
  min-width: 88rpx; min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}

.card {
  background: #fff; border-radius: 16rpx; padding: 8rpx 28rpx;
}
.row {
  display: flex; align-items: center;
  min-height: 96rpx; border-bottom: 1rpx solid #f0f1f5;
}
.row:last-child { border-bottom: none; }
.label { width: 180rpx; color: #333; font-size: 28rpx; flex-shrink: 0; }
.field { flex: 1; font-size: 28rpx; }
.picker { flex: 1; }
.picker-value { color: #1989fa; font-size: 28rpx; display: flex; align-items: center; justify-content: flex-end; }
/* 用 CSS 画一个下拉箭头，避免 ▾ 等特殊字符在某字体下显示成方块 */
.arrow {
  width: 0; height: 0; margin-left: 12rpx; flex-shrink: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #1989fa;
}

.tip {
  margin-top: 24rpx; background: #fffbe8; border: 1rpx solid #ffe58f;
  border-radius: 16rpx; padding: 24rpx; font-size: 24rpx; color: #ad8b00; line-height: 1.7;
}
.tip-title { font-weight: 600; margin-bottom: 8rpx; }