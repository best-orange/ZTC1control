/* pages/device-control/device-control.wxss */
page {
  height: 100vh;
  background: #f5f6fa;
  display: flex; flex-direction: column;
}
.scrollarea { flex: 1; overflow-y: auto; padding: 24rpx; box-sizing: border-box; }
.refresh {
  color: #1989fa; font-size: 28rpx;
  padding: 0 28rpx;
  min-width: 88rpx; min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
/* 导航栏右侧两个操作按钮（改名 / 刷新）并排 */
.nav-actions { display: flex; align-items: center; }
.nav-actions .refresh { padding: 0 20rpx; min-width: 0; }
.nav-btn-hover { opacity: 0.6; }

.connbar {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-bottom: 20rpx;
  font-size: 26rpx;
}
.connbar .dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 14rpx; }
.conn-on .dot { background: #07c160; }
.conn-off .dot { background: #d0d3da; }
.conn-on .conn-text { color: #07c160; }
.conn-off .conn-text { color: #9699a3; }
.connbar .mqtt-text { margin-left: auto; color: #9699a3; font-size: 24rpx; }

.card {
  background: #fff; border-radius: 16rpx;
  padding: 8rpx 28rpx; margin-bottom: 20rpx;
  overflow: hidden;
}
.kv {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 84rpx; border-bottom: 1rpx solid #f2f3f7;
}
.kv:last-child { border-bottom: none; }
.kv .k { color: #9699a3; font-size: 28rpx; }
.kv .v { font-size: 28rpx; color: #1a1a1a; }
.kv .v.mono { font-family: monospace; }
.kv .v.val { color: #1989fa; font-weight: 600; font-size: 30rpx; }

.master {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 16rpx;
}
.master-left { display: flex; align-items: baseline; }
.master-label { font-size: 30rpx; font-weight: 600; }
.master-sub { font-size: 22rpx; color: #9699a3; margin-left: 14rpx; }
.plug-grid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  padding: 8rpx 0 16rpx;
}
.plug {
  width: 100%;
  display: flex; align-items: center;
  min-height: 88rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
}
.plug:last-child { border-bottom: none; }
.plug-info { flex: 1; display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
.plug-name { font-size: 30rpx; color: #333; font-weight: 500; }
.plug-sub { font-size: 22rpx; color: #b0b3b9; margin-top: 2rpx; }
.plug-task {
  margin-top: 10rpx; font-size: 22rpx; color: #1989fa;
  padding: 4rpx 14rpx; background: #eaf3ff; border-radius: 8rpx;
}
.plug-task-hover { opacity: 0.6; }

/* —— 定时任务弹窗 —— */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5); z-index: 100;
}
.task-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  z-index: 101; max-height: 78vh;
  display: flex; flex-direction: column;
  padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.ts-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12rpx; }
.ts-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; }
.ts-close { font-size: 32rpx; color: #999; padding: 0 8rpx; }
.ts-tip { font-size: 22rpx; color: #9699a3; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f1f5; }
.ts-scroll { flex: 1; overflow-y: auto; max-height: 55vh; }
.ts-item {
  display: flex; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx solid #f2f3f7;
}
.ts-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.ts-line { display: flex; align-items: baseline; }
.ts-time { font-size: 30rpx; font-weight: 600; color: #1a1a1a; margin-right: 16rpx; }
.ts-action { font-size: 24rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.ts-action.open { color: #07c160; background: #e8f8ef; }
.ts-action.close { color: #fa5151; background: #fdecec; }
.ts-repeat { font-size: 22rpx; color: #9699a3; margin-top: 4rpx; }

.ts-editor {
  margin-top: 20rpx; background: #f8f9fc; border-radius: 16rpx; padding: 20rpx;
}
.ts-e-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.ts-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.ts-label { width: 110rpx; font-size: 26rpx; color: #666; flex-shrink: 0; }
.ts-picker { margin-right: 16rpx; }
.ts-picker-val {
  min-width: 110rpx; text-align: center; font-size: 26rpx; color: #1989fa;
  background: #fff; border: 1rpx solid #e3e6ee; border-radius: 8rpx; padding: 10rpx 16rpx;
}
.ts-seg { display: flex; border: 1rpx solid #dde2ec; border-radius: 8rpx; overflow: hidden; }
.seg { padding: 10rpx 32rpx; font-size: 26rpx; color: #666; background: #fff; }
.seg.on { background: #1989fa; color: #fff; }
.ts-week { display: flex; }
.week {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  margin-right: 10rpx; border-radius: 8rpx;
  font-size: 24rpx; color: #666; background: #fff; border: 1rpx solid #e3e6ee;
}
.week.on { background: #1989fa; color: #fff; border-color: #1989fa; }
.ts-enable { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 20rpx; }
.ts-actions { display: flex; justify-content: flex-end; }
.ts-actions button {
  margin-left: 16rpx; padding: 0 32rpx; height: 72rpx; line-height: 72rpx;
  font-size: 28rpx; border-radius: 40rpx;
}
.btn-del-bg { background: #fff; color: #fa5151; border: 1rpx solid #fa5151; }
.btn-del-bg::after { border: none; }
.btn-save-bg { background: #1989fa; color: #fff; }
.btn-save-bg::after { border: none; }

.tip {
  background: #fffbe8; border: 1rpx solid #ffe58f;
  border-radius: 16rpx; padding: 24rpx;
  font-size: 24rpx; color: #ad8b00; line-height: 1.7;
  margin-top: 8rpx;
}